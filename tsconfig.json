{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@theme/*": ["app/theme/*"],
      "@components/*": ["components/*"],
      "@assets/*": ["assets/*"],
      "@/*": ["*"],
      "@/store/*": ["store/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
